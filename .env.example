# TicketGOAT Environment Variables
# This is an example file. Copy it to .env if you need custom environment variables.

# OCR Service URL (optional - configure in app settings)
# For local development: http://192.168.1.x:8000
# For production: https://your-ocr-service.com
EXPO_PUBLIC_OCR_API_URL=http://localhost:8000

# Note: Stock prices use Yahoo Finance API which is completely free
# and requires no API key configuration.
